# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://nexo:nexo@localhost:5432/nexo?schema=public"

# LLM (reasoning/chat) — Anthropic is the default ChatProvider
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Embeddings — OpenAI is the default EmbeddingProvider (Anthropic has no public embeddings API)
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Confidence-based escalation threshold (0-1). Below this, the orchestrator
# escalates to a human instead of answering.
CONFIDENCE_THRESHOLD=0.55
