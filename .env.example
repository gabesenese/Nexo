# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://nexo:nexo@localhost:5432/nexo?schema=public"

# AI provider selection: "ollama" (local, free, default) or "cloud" (OpenAI + Anthropic).
AI_PROVIDER=ollama

# Local provider (Ollama, OpenAI-compatible API). Requires `ollama pull llama3.1:8b`
# and `ollama pull nomic-embed-text`. Chat + embeddings run on-machine, no keys.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="llama3.1:8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Must match the pgvector column dimension. 768 for nomic-embed-text, 1536 for OpenAI.
EMBEDDING_DIMENSIONS=768

# Cloud provider keys. Only required when AI_PROVIDER=cloud.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Server
PORT=4000

# Public origin the admin console is served from. Decides whether the session
# cookie is marked `secure`, so in production this MUST be https: the server
# refuses to boot with NODE_ENV=production and a non-https APP_URL.
#
# It must also share a registrable domain with this API. The session cookie is
# SameSite=lax, so an admin console on an unrelated host would stop sending it.
APP_URL="http://localhost:5173"

# Origins allowed to make credentialed requests: the admin console and the
# landing site, comma separated. Widget endpoints ignore this and answer any
# origin without credentials, since they are embedded on customer domains.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Requests per minute per IP, on three separate counters so one cannot spend
# another. The general ceiling is generous because an operator working the inbox
# is legitimately chatty. Auth is sized for a whole support team signing in from
# one office NAT at 9am, since the limiter counts successful logins too. Chat is
# the tightest, because it is the one public endpoint that costs money per call.
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_CHAT_MAX=30

# Confidence-based escalation threshold (0-1). Below this, the orchestrator
# escalates to a human instead of answering.
CONFIDENCE_THRESHOLD=0.55

# How long after a resolution a returning customer reopens the same thread
# instead of starting a new conversation. Past this window the next message is
# treated as a genuinely new issue.
REOPEN_WINDOW_HOURS=72
