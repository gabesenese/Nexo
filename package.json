{
  "name": "nexo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,admin,widget,landing -c blue,green,magenta,yellow \"npm run dev --workspace=@nexo/server\" \"npm run dev --workspace=@nexo/admin\" \"npm run dev --workspace=@nexo/widget\" \"npm run dev --workspace=@nexo/landing\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@nexo/server",
    "db:generate": "npm run db:generate --workspace=@nexo/server",
    "db:seed": "npm run db:seed --workspace=@nexo/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
