generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

enum SourceType {
  help_center
  pdf
}

enum SourceStatus {
  queued
  fetching
  chunking
  embedding
  ready
  failed
}

enum ConversationStatus {
  active
  resolved
  escalated
}

enum MessageRole {
  user
  assistant
  agent
}

enum EscalationStatus {
  pending
  handed_off
}

enum NotificationType {
  escalation
}

enum Role {
  owner
  admin
  agent
  viewer
}

enum Plan {
  essentials
  professional
  growth
}

enum WebhookDeliveryStatus {
  succeeded
  failed
}

model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String            @unique
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  conversationId String?
  event          String
  status         WebhookDeliveryStatus
  statusCode     Int?
  attempts       Int                   @default(1)
  error          String?
  durationMs     Int?
  createdAt      DateTime              @default(now())

  @@index([endpointId, createdAt])
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  widgetKey     String         @unique
  createdAt     DateTime       @default(now())

  plan          Plan           @default(essentials)
  trialEndsAt   DateTime?

  averageHandleMinutes Int?
  supportHourlyCostCad Float?
  memberships   Membership[]
  invites       Invite[]
  sources       Source[]
  conversations Conversation[]
  leads         Lead[]
  widgetConfig  WidgetConfig?
  notifications Notification[]
  webhookEndpoint WebhookEndpoint?
  auditEvents   AuditEvent[]
}

model WidgetConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accentColor    String       @default("#204c40")
  welcomeMessage String       @default("Hi! Ask me anything. I'll cite my sources, and you can talk to a human any time.")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(agent)
  token          String       @unique
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?

  @@unique([organizationId, email])
  @@index([organizationId])
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  name                  String
  createdAt             DateTime       @default(now())
  passwordChangedAt     DateTime?
  memberships           Membership[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  notes                 Note[]         @relation("NoteAuthor")
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(owner)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null when Nexo itself acted rather than a person. Email and name are copied
  /// rather than joined, so the record still reads correctly after the account is
  /// removed from the workspace, which is when an audit log is most likely read.
  actorUserId    String?
  actorEmail     String?
  actorName      String?

  action         String
  targetType     String?
  targetId       String?
  targetLabel    String?
  metadata       Json         @default("{}")
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Source {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            SourceType
  name            String
  origin          String
  status          SourceStatus  @default(queued)
  errorMessage    String?
  notice          String?
  totalChunks     Int?
  processedChunks Int           @default(0)
  pageCount       Int?
  truncated       Boolean       @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  chunks          Chunk[]

  @@index([organizationId])
}

model Chunk {
  id         String                 @id @default(cuid())
  sourceId   String
  source     Source                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(768)")?
  tokenCount Int
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())

  @@index([sourceId])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  channel        String             @default("widget")
  status         ConversationStatus @default(active)
  assignedUserId String?
  assignedUser   User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  resolvedAt     DateTime?
  reopenCount    Int                @default(0)
  lastReopenedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       Message[]
  escalations    Escalation[]
  notifications  Notification[]
  notes          Note[]

  @@index([sessionId])
  @@index([organizationId])
  @@index([assignedUserId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citations      Json         @default("[]")
  confidence     Float?
  authorUserId   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Note {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUserId   String?
  author         User?        @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Escalation {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String
  summary        String
  handoffPayload Json              @default("{}")
  status         EscalationStatus  @default(pending)
  createdAt      DateTime          @default(now())

  question          String?
  questionEmbedding Unsupported("vector(768)")?

  @@index([conversationId])
}

model Notification {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           NotificationType  @default(escalation)
  message        String
  read           Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([organizationId, read])
  @@index([conversationId])
}

model Lead {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  company        String
  source         String        @default("landing")
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}
