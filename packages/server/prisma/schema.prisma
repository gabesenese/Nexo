generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

enum SourceType {
  help_center
  pdf
}

enum SourceStatus {
  queued
  fetching
  chunking
  embedding
  ready
  failed
}

enum ConversationStatus {
  active
  resolved
  escalated
}

enum MessageRole {
  user
  assistant
  agent
}

enum EscalationStatus {
  pending
  handed_off
}

enum NotificationType {
  escalation
}

enum Role {
  owner
  admin
  member
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  widgetKey     String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  invites       Invite[]
  sources       Source[]
  conversations Conversation[]
  leads         Lead[]
  widgetConfig  WidgetConfig?
  notifications Notification[]
}

model WidgetConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accentColor    String       @default("#204c40")
  welcomeMessage String       @default("Hi! Ask me anything. I'll cite my sources, and you can talk to a human any time.")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(member)
  token          String       @unique
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?

  @@unique([organizationId, email])
  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(owner)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Source {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            SourceType
  name            String
  origin          String
  status          SourceStatus  @default(queued)
  errorMessage    String?
  totalChunks     Int?
  processedChunks Int           @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  chunks          Chunk[]

  @@index([organizationId])
}

model Chunk {
  id         String                 @id @default(cuid())
  sourceId   String
  source     Source                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(768)")?
  tokenCount Int
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())

  @@index([sourceId])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  channel        String             @default("widget")
  status         ConversationStatus @default(active)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       Message[]
  escalations    Escalation[]
  notifications  Notification[]

  @@index([sessionId])
  @@index([organizationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citations      Json         @default("[]")
  confidence     Float?
  authorUserId   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Escalation {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String
  summary        String
  handoffPayload Json              @default("{}")
  status         EscalationStatus  @default(pending)
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

model Notification {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           NotificationType  @default(escalation)
  message        String
  read           Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([organizationId, read])
  @@index([conversationId])
}

model Lead {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  company        String
  source         String        @default("landing")
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}
