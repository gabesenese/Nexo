# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://nexo:nexo@localhost:5432/nexo?schema=public"

# AI provider selection: "ollama" (local, free, default) or "cloud" (OpenAI + Anthropic).
AI_PROVIDER=ollama

# Local provider (Ollama, OpenAI-compatible API). Requires `ollama pull llama3.1:8b`
# and `ollama pull nomic-embed-text`. Chat + embeddings run on-machine, no keys.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="llama3.1:8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Must match the pgvector column dimension. 768 for nomic-embed-text, 1536 for OpenAI.
EMBEDDING_DIMENSIONS=768

# Cloud provider keys. Only required when AI_PROVIDER=cloud.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Server
PORT=4000

# Public origin the admin console is served from. Decides whether the session
# cookie is marked `secure`, so in production this MUST be https: the server
# refuses to boot with NODE_ENV=production and a non-https APP_URL.
#
# It must also share a registrable domain with this API. The session cookie is
# SameSite=lax, so an admin console on an unrelated host would stop sending it.
APP_URL="http://localhost:5173"

# Origins allowed to make credentialed requests: the admin console and the
# landing site, comma separated. Widget endpoints ignore this and answer any
# origin without credentials, since they are embedded on customer domains.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Requests per minute per IP, on three separate counters so one cannot spend
# another. The general ceiling is generous because an operator working the inbox
# is legitimately chatty. Auth is sized for a whole support team signing in from
# one office NAT at 9am, since the limiter counts successful logins too. Chat is
# the tightest, because it is the one public endpoint that costs money per call.
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_CHAT_MAX=30

# Email. "log" prints messages instead of sending them, so a fresh clone can
# complete a password reset with no account anywhere. Production must be "smtp":
# the server refuses to boot on "log", because a reset that silently sends
# nothing is indistinguishable from one that worked.
#
# SMTP_URL is any provider's connection string, which is why this is SMTP rather
# than one vendor's API. Resend, Postmark, SES and Mailgun all speak it, so the
# choice of provider stays a change of URL.
EMAIL_TRANSPORT=log
SMTP_URL=""
EMAIL_FROM="Nexo <no-reply@localhost>"

# How long a password reset link stays usable. Short, because it is a bearer
# credential: whoever holds the link becomes the account.
PASSWORD_RESET_TTL_MINUTES=60

# Billing. Leave STRIPE_SECRET_KEY empty and the product runs exactly as it does
# now, with the billing surface reporting that this deployment cannot take
# payments. That keeps a fresh clone and any self-hosted install from needing a
# payment processor to answer a support question.
#
# STRIPE_WEBHOOK_SECRET is not optional once the secret key is set: the server
# refuses to boot without it. Checkout with no verified webhook charges the card
# and never activates the plan, which is the one billing bug that takes money and
# delivers nothing.
#
# Locally, `stripe listen --forward-to localhost:4000/api/stripe/webhook` prints
# the signing secret to paste here.
#
# The price ids come from the Products page in the Stripe Dashboard. Prices are
# read from Stripe at runtime rather than restated in this repo, so the figure
# the console shows is the figure the card is charged.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENTIALS=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_GROWTH=""
# Where Stripe returns the customer after checkout. Defaults to APP_URL/settings.
# Left commented rather than blank: it is validated as a URL, and an empty string
# is not one, so setting it to "" would stop the server booting.
# BILLING_RETURN_URL="https://console.example.com/settings"

# Confidence-based escalation threshold (0-1). Below this, the orchestrator
# escalates to a human instead of answering.
CONFIDENCE_THRESHOLD=0.55

# How long after a resolution a returning customer reopens the same thread
# instead of starting a new conversation. Past this window the next message is
# treated as a genuinely new issue.
REOPEN_WINDOW_HOURS=72
