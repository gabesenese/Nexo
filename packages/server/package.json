{
  "name": "@nexo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/demo-seed.ts",
    "db:backfill:escalation-questions": "tsx prisma/backfill-escalation-questions.ts",
    "db:reembed": "tsx prisma/reembed.ts",
    "measure:thresholds": "tsx scripts/measure-thresholds.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "gpt-tokenizer": "^2.5.1",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
